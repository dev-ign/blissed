{
  "name": "blissed-by-mayi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prerender-fallback.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --allowUnreachableCode false --allowUnusedLabels false",
    "test": "node scripts/test-booking.mjs",
    "test:browser": "node scripts/booking-browser-qa.cjs",
    "test:visual": "node scripts/visual-refinement-qa.cjs",
    "test:contrast": "node scripts/check-design-contrast.mjs",
    "test:motion": "node scripts/motion-browser-qa.cjs",
    "test:static": "node scripts/static-fallback-qa.cjs"
  },
  "dependencies": {
    "@fontsource/allura": "^5.2.7",
    "@fontsource/cormorant-garamond": "^5.2.7",
    "@fontsource/manrope": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.7",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
